# docker compose 用环境文件模板。
# 复制为 .env.docker 后填写，再执行：docker compose --env-file .env.docker up -d
# 该文件含全部密钥，权限设为 600，且不要提交到版本库。

# 数据库密码（首次启动后再改需同时改库中的角色密码）
POSTGRES_PASSWORD=

# session cookie 签名密钥，不少于 32 字符：openssl rand -hex 32
TZL_SESSION_SECRET=

# 渠道上游密钥的加密密钥：openssl rand -hex 32
# 一旦设定不可变更，丢失则库中已加密的渠道密钥全部无法解密，必须向各上游厂商重新索取。
# 务必随数据库备份一起离机保存（见 deploy/backup-secrets.sh）。
TZL_ENCRYPT_KEY=

# 初始管理员账号；密码留空则由服务生成随机密码并打印到日志（docker compose logs backend）
TZL_ROOT_USERNAME=root
TZL_ROOT_PASSWORD=

# 会话 cookie 的 Secure 属性。必须与浏览器实际访问站点的协议一致：
#   false —— 本编排默认，以明文 HTTP 提供服务时使用。登录凭据在链路上明文传输，
#            仅在可信内网可接受。
#   true  —— 在本编排前面接入了 TLS 反向代理、员工以 https:// 访问时使用。
# 取值与实际协议不一致的后果：设为 true 而站点是明文 HTTP 时，浏览器不保存会话
# cookie，用户登录后立即掉登录态（管理端绑回环地址属安全上下文，自测时发现不了）。
TZL_SESSION_COOKIE_SECURE=false

# 端口与绑定地址
# 用户端 Portal 与 /v1 中继对外提供服务
PORTAL_BIND=0.0.0.0
PORTAL_PORT=8080
# 管理端默认只绑宿主机回环地址，远程访问经 SSH 隧道或外层反向代理
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8081

# 编排网络网段：后端据此判定哪些来源的 X-Real-IP 头可信，
# 与宿主机既有网段冲突时才需要修改
TZL_NETWORK_SUBNET=172.28.0.0/16

# 日志级别: debug | info | warn | error
TZL_LOG_LEVEL=info

# 上游请求总超时秒数
TZL_UPSTREAM_TIMEOUT_SEC=600

# /metrics 抓取令牌（Authorization: Bearer <令牌>）。留空时该端点只接受 root 会话。
TZL_METRICS_TOKEN=
