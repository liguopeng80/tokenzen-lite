# Token Zen Lite 前端镜像：构建 admin 与 portal 两个前端，由 Nginx 托管并反代后端。
# 构建上下文为仓库根目录：docker build -f Dockerfile.web -t tokenzen/web .

FROM node:22-alpine AS build
WORKDIR /src
RUN corepack enable
# 先拷工作区清单，依赖未变时复用缓存层
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
COPY apps/portal/package.json apps/portal/
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM nginx:1.27-alpine
COPY --from=build /src/apps/portal/dist /usr/share/nginx/html/portal
COPY --from=build /src/apps/admin/dist  /usr/share/nginx/html/admin
COPY deploy/nginx-docker.conf /etc/nginx/conf.d/default.conf
# 8080 = 用户端 Portal（含 /api 与 /v1 反代），8081 = 管理端 Admin
EXPOSE 8080 8081
