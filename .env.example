# Token Zen Lite 环境配置模板。复制为 .env 后按环境修改（scripts/start.sh 会自动加载）。
# 生产部署必填：TZL_DATABASE_URL、TZL_SESSION_SECRET、TZL_ENCRYPT_KEY。

# ===== 应用配置 =====

# 运行环境: dev | prod（prod 下强制校验密钥项）
TZL_ENV=dev

# HTTP 服务绑定地址，默认仅监听回环；对外直接暴露时才改为 0.0.0.0
TZL_BIND_ADDR=127.0.0.1

# HTTP 服务端口（dev 脚本会以 19030 覆盖）
TZL_PORT=19030

# PostgreSQL 连接串（必填）；本地开发库示例，change-me 换成本机实际密码
TZL_DATABASE_URL=postgres://tzl:change-me@localhost:5433/tzl_dev?sslmode=disable

# 可信反向代理来源（IP 或 CIDR，逗号分隔）。仅来自这些地址的连接才采信
# X-Real-IP 头作为客户端 IP；留空表示不信任任何代理
TZL_TRUSTED_PROXIES=

# 日志级别: debug | info | warn | error
TZL_LOG_LEVEL=info

# 优雅停机等待秒数
TZL_SHUTDOWN_TIMEOUT_SEC=15

# 上游请求总超时（秒，含流式）
TZL_UPSTREAM_TIMEOUT_SEC=600

# 是否开放用户自助注册（企业内部部署默认由管理员建号）
TZL_REGISTER_ENABLED=false

# 会话 cookie 是否带 Secure 属性；须与站点实际协议一致（HTTPS 站点用 true）
TZL_SESSION_COOKIE_SECURE=

# ===== 密钥（生产必填）=====

# session cookie 签名密钥，生产必填且不少于 32 字符：openssl rand -hex 32
TZL_SESSION_SECRET=

# 渠道上游密钥的加密密钥：openssl rand -hex 32。一旦设定不可变更，
# 丢失则库中已加密的渠道密钥全部无法解密，务必随数据库备份一起离机保存
TZL_ENCRYPT_KEY=

# 首次启动引导的 root 账号（仅系统无用户时生效；密码留空则生成随机密码打印到日志）
TZL_ROOT_USERNAME=root
TZL_ROOT_PASSWORD=

# /metrics 抓取令牌（Authorization: Bearer <令牌>）。留空时该端点只接受 root 会话
TZL_METRICS_TOKEN=

# ===== 调试（默认关闭）=====

# 请求录制文件根目录；留空禁用，设置后录制文件落 <RecordDir>/recordings/YYYY/MM/DD/
TZL_RECORD_DIR=

# ===== 测试与运维脚本 =====

# Go 集成测试库连接串（未设置时集成测试自动跳过；也可经 Makefile 的 TEST_DB_URL 覆盖）
TZL_TEST_DATABASE_URL=

# deploy/backup.sh、backup-secrets.sh 在 tzl 二进制不可用时的告警 Webhook 回退地址
TZL_ALERT_WEBHOOK=

# ===== Docker Compose 专用（.env.docker，见 .env.docker.example）=====
# POSTGRES_PASSWORD / PORTAL_BIND / PORTAL_PORT / ADMIN_BIND / ADMIN_PORT /
# TZL_NETWORK_SUBNET / TZL_VERSION 的取值说明见 .env.docker.example
